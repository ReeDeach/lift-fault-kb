# Скопируйте в .env и заполните. Файл .env в git не попадает.

APP_ENV=local

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lift_kb
DB_USER=lift
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Админ-API (Authorization: Bearer <токен>). Пусто — админ-API выключено.
# Сгенерировать: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
ADMIN_TOKEN=

# Manticore (SphinxQL по MySQL-протоколу)
MANTICORE_HOST=manticore
MANTICORE_PORT=9306

# ИИ-диагностика (Gemini API). Пустой ключ — диагностика без ИИ, по базе
AI_API_KEY=
AI_MODEL=gemini-3.5-flash
# Запасные модели через запятую: пробуются, если основная перегружена или недоступна
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Таймаут одного запроса к модели, секунд
AI_TIMEOUT=15

# Вход и роли (личный журнал). Пользователь определяется по аккаунту Tailscale (tailscale serve).
# Права мастера — у аккаунтов из списка через запятую. Механиком может войти любой аккаунт сети.
MASTER_LOGINS=
# Только для разработки при APP_ENV=local: вход без Tailscale под этим аккаунтом. На сервере пусто.
AUTH_DEV_LOGIN=

# Push-уведомления на телефоны (Web Push). Ключи: docker compose exec php php bin/push-keys.php
# Пусто — уведомления выключены. Если ключи сменить, устройства придётся подписать заново.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для служб уведомлений (Google, Apple, Mozilla): адрес сайта https://… или mailto:
VAPID_SUBJECT=
# Часовой пояс для «тишины ночью» (22:00–7:00)
APP_TIMEZONE=Europe/Minsk
