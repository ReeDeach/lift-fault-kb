# Скопируйте в .env и заполните. Файл .env в git не попадает.

APP_ENV=local

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lift_kb
DB_USER=lift
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Админ-API (Authorization: Bearer <токен>). Пусто — админ-API выключено.
# Сгенерировать: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
ADMIN_TOKEN=

# Manticore (SphinxQL по MySQL-протоколу)
MANTICORE_HOST=manticore
MANTICORE_PORT=9306

# ИИ-диагностика (Gemini API). Пустой ключ — диагностика без ИИ, по базе
AI_API_KEY=
AI_MODEL=gemini-flash-latest
# Запасные модели через запятую: пробуются, если основная перегружена или недоступна
AI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
# Таймаут одного запроса к модели, секунд
AI_TIMEOUT=25

# Вход и роли (личный журнал). Пользователь определяется по аккаунту Tailscale (tailscale serve).
# Права мастера — у аккаунтов из списка через запятую. Механиком может войти любой аккаунт сети.
MASTER_LOGINS=
# Только для разработки при APP_ENV=local: вход без Tailscale под этим аккаунтом. На сервере пусто.
AUTH_DEV_LOGIN=
